+          aligned.setPageDimensions(sample, zoom, 2400, arrangement, movement, 1600, dpr);
+          logical.setPageDimensions(sample, zoom, 2400, arrangement, movement, 1600);
+          for (let index = 0; index < 4; index++) {
+            const top = aligned.getPageOffset(index);
+            assert.ok(Math.abs(top * dpr - Math.round(top * dpr)) < 1e-8,
+              `${arrangement.kind}/${movement}/${zoom}/${dpr}: origin ${top}`);
