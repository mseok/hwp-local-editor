+            const y = top + aligned.getPageHeight(index) / 2;
+            assert.equal(aligned.getPageAtPoint(x, y), index);
+            assert.ok(aligned.getVisiblePages(y - 1, 2, 0, Math.max(2400, aligned.getTotalWidth())).includes(index));
