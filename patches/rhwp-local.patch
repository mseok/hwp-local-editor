+#[cfg(test)]
+mod native_pua_bullet_tests {
+    use super::*;
+    use crate::renderer::style_resolver::ResolvedParaStyle;
+
+    fn marker(source: char, native: bool) -> (String, TextStyle) {
+        let styles = ResolvedStyleSet {
+            native_pua_bullet_face: native.then(|| "바탕".into()),
+            bullets: vec![crate::model::style::Bullet {
+                bullet_char: source,
+                char_shape_id: u32::MAX,
+                ..Default::default()
+            }],
+            ..Default::default()
+        };
+        let para = ResolvedParaStyle {
+            head_type: HeadType::Bullet,
+            numbering_id: 1,
+            ..Default::default()
+        };
+        let (text, head) = bullet_marker_text(&para, &styles).unwrap();
+        let style = marker_text_style(&styles, head, &text, || TextStyle {
+            font_family: "맑은 고딕".into(),
+            font_size: 16.0,
+            ..Default::default()
+        });
+        (text, style)
+    }
+
+    #[test]
+    fn reference_symbol_bullets_keep_original_glyph_and_face() {
+        for source in ['\u{F09F}', '\u{F0FC}'] {
+            let (text, style) = marker(source, true);
+            assert_eq!(text, source.to_string());
+            assert_eq!(style.font_family, "바탕");
+            assert!(style.native_pua_glyphs);
+            assert_eq!(style.paint_text(&text), text);
+            assert_eq!(style.font_size, 16.0);
+        }
+    }
+
+    #[test]
+    fn default_and_unicode_bullets_keep_their_previous_behavior() {
+        let (text, style) = marker('\u{F09F}', false);
+        assert_eq!(text, "•");
+        assert_eq!(style.font_family, "맑은 고딕");
+        assert!(!style.native_pua_glyphs);
+        let (text, style) = marker('▶', true);
+        assert_eq!(text, "▶");
+        assert_eq!(style.font_family, "맑은 고딕");
+        assert!(!style.native_pua_glyphs);
+    }
+}
