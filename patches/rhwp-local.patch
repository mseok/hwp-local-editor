+#[test]
+fn document_substitute_ascii_paint_preserves_stored_lines_and_hangul_slots() {
+    let text = "한글(PLK1) 대상.";
+    let para = Paragraph {
+        text: text.into(),
+        char_offsets: (0..text.chars().count() as u32).collect(),
+        char_count: text.chars().count() as u32 + 1,
+        char_shapes: vec![CharShapeRef {
+            start_pos: 0,
+            char_shape_id: 0,
+        }],
+        line_segs: vec![LineSeg {
+            text_start: 0,
+            vertical_pos: 1200,
+            line_height: 1000,
+            baseline_distance: 800,
+            segment_width: 24000,
+            ..Default::default()
+        }],
+        ..Default::default()
+    };
+    let mut styles = make_styles_with_font_size(16.0);
+    let before = compose_paragraph_in_context(&para, &styles);
+    assert!(before.lines[0]
+        .runs
+        .iter()
+        .any(|run| { run.lang_index == 0 && run.text.contains('(') }));
+    styles.char_styles[0].ascii_punct_latin_paint = true;
+    styles.char_styles[0].ascii_punct_latin_slot = true;
+    let after = compose_paragraph_in_context(&para, &styles);
+    assert_eq!(after.lines.len(), before.lines.len());
+    assert_eq!(after.lines[0].line_height, 1000);
+    assert_eq!(after.lines[0].baseline_distance, 800);
+    assert_eq!(para.line_segs[0].vertical_pos, 1200);
+    assert_eq!(after.lines[0].segment_width, 24000);
+    let mut restored = String::new();
+    for run in &after.lines[0].runs {
+        restored.push_str(&run.text);
+        for ch in run.text.chars() {
+            if ch.is_ascii_punctuation() {
+                assert_eq!(run.lang_index, 1, "{ch}");
+            } else if matches!(ch, '한' | '글' | '대' | '상') {
+                assert_eq!(run.lang_index, 0, "{ch}");
+            }
+        }
+    }
+    assert_eq!(restored, text);
+    assert_eq!(para.text, text);
+}
