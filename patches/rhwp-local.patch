+/// A split table can store only its opening row in the object-height box.
+/// Reconcile that row's stale cell minimum without scaling later rows or
+/// clipping text. Edited, synthetic and merged rows cannot use this frame.
+pub(crate) fn stored_opening_row_height_hu(table: &Table) -> Option<i32> {
+    if table.common.treat_as_char
+        || table.row_count < 2
+        || table.common.height == 0
+        || table.common.height >= 0x8000_0000
+        || table.page_break != TablePageBreak::RowBreak
+        || table.cells.iter().any(|cell| cell.row_span != 1)
+    {
+        return None;
+    }
+    let target = table.common.height as i32;
+    let first: Vec<_> = table.cells.iter().filter(|cell| cell.row == 0).collect();
+    if first.is_empty()
+        || first.iter().any(|cell| {
+            cell.height <= table.common.height
+                || cell.paragraphs.is_empty()
+                || cell.paragraphs.iter().any(|para| {
+                    para.stored_text_partition_dirty
+                        || !para.controls.is_empty()
+                        || para.line_segs.is_empty()
+                        || para
+                            .line_segs
+                            .iter()
+                            .any(|line| line.tag & LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0)
+                })
+                || {
+                    let padding = cell.effective_padding(&table.padding);
+                    let end = cell
+                        .paragraphs
+                        .iter()
+                        .flat_map(|p| &p.line_segs)
+                        .map(|line| {
+                            i64::from(line.vertical_pos)
+                                + i64::from(line.line_height)
+                                + i64::from(line.line_spacing.max(0))
+                        })
+                        .max()
+                        .unwrap_or(0);
+                    end + i64::from(padding.top) + i64::from(padding.bottom) > i64::from(target)
+                }
+        })
+    {
+        return None;
+    }
+    table
+        .cells
+        .iter()
+        .filter(|cell| cell.row > 0)
+        .any(|cell| {
+            cell.paragraphs
+                .first()
+                .and_then(|p| p.line_segs.first())
+                .is_some_and(|line| line.vertical_pos == 0)
+                && cell
+                    .paragraphs
+                    .iter()
+                    .flat_map(|p| &p.line_segs)
+                    .any(|line| {
+                        i64::from(line.vertical_pos) + i64::from(line.line_height)
+                            > i64::from(target)
+                    })
+        })
+        .then_some(target)
