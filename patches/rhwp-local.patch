+pub(crate) fn quantized_paint_size(size: f64, quantum: Option<f64>) -> f64 {
+    let Some(quantum) = quantum.filter(|q| q.is_finite() && *q > 0.0) else {
+        return size;
+    };
+    let painted = (size / quantum).round() * quantum;
+    if painted.is_finite() && painted > 0.0 {
+        painted
+    } else {
+        size
+    }
+}
+
+pub(crate) fn quantized_css_descriptor(descriptor: &str, quantum: Option<f64>) -> String {
+    let Some((prefix, family)) = descriptor.split_once("px ") else {
+        return descriptor.to_owned();
+    };
+    let (weight, size) = prefix
+        .rsplit_once(' ')
+        .map_or(("", prefix), |(a, b)| (a, b));
+    let Ok(size) = size.parse::<f64>() else {
+        return descriptor.to_owned();
+    };
+    if quantum.is_none() {
+        return descriptor.to_owned();
+    }
+    let rounded = format!("{:.3}", quantized_paint_size(size, quantum));
+    let size = rounded.trim_end_matches('0').trim_end_matches('.');
+    let weight = if weight.is_empty() {
+        String::new()
+    } else {
+        format!("{weight} ")
+    };
+    format!("{weight}{size}px {family}")
+}
 
