+        || !(st.profile.hwpx_stored_layout() || st.profile.hwp5_stored_pagination_layout())
+        || para.stored_text_partition_is_dirty()
+        || para.cell_format_vpos_dirty
+        || line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+        || !matches!(para.controls.as_slice(), [Control::Table(_)])
+        || para_has_non_whitespace_text(para)
+    {
+        return None;
+    }
+    let height = crate::renderer::height_measurer::stored_opening_row_height_hu(table)?;
+    let before = styles
+        .para_styles
+        .get(para.para_shape_id as usize)?
+        .spacing_before;
+    let origin = st.vpos_col_anchor
+        + crate::renderer::hwpunit_to_px(
+            line.vertical_pos - st.vpos_page_base.or(st.vpos_lazy_base).unwrap_or(0),
+            dpi,
+        );
+    ((origin - before - st.current_height).abs() <= 2.0 * dpi / 7200.0)
+        .then(|| crate::renderer::hwpunit_to_px(height, dpi))
+}
