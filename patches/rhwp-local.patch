+/// A saved text prefix and its TAC object can own different physical pages.
+/// Keep the authored row cut instead of moving the entire paragraph with the table.
+pub(super) fn prepare_text_reset(
+    para_idx: usize,
+    para: &Paragraph,
+    fmt: &FormattedParagraph,
+    measured_tables: &[MeasuredTable],
+    page: StoredTacPage,
+    available: f64,
+    dpi: f64,
+) -> Option<(usize, f64, StoredTacControlPlacement)> {
+    if !(page.profile.hwp5_stored_pagination_layout() || page.profile.hwpx_stored_layout())
+        || page.profile.session_edited()
+        || !page.side_wrap_empty
+        || para.stored_text_partition_is_dirty()
+        || para.cell_format_vpos_dirty
+        || para.line_segs.len() < 2
+        || para.line_segs.len() != fmt.line_heights.len()
+    {
+        return None;
+    }
+    let [Control::Table(table)] = para.controls.as_slice() else {
+        return None;
+    };
+    let cut = para.line_segs.len() - 1;
+    let tail = &para.line_segs[cut];
+    if !table.common.treat_as_char
+        || table.caption.is_some()
+        || table_has_notes(table)
+        || tail.vertical_pos < 0
+        || tail.vertical_pos >= para.line_segs[cut - 1].vertical_pos
+        || crate::renderer::layout::control_line_seg_index(para, 0) != Some(cut)
+        || para.line_segs.iter().any(|line| {
+            line.line_height <= 0
+                || line.tag & crate::model::paragraph::LineSeg::TAG_IMPLEMENTATION_PROPERTY != 0
+        })
+        || para.line_segs[..cut]
+            .iter()
+            .any(|line| line.vertical_pos <= 0)
+        || para.line_segs[..cut]
+            .windows(2)
+            .any(|pair| pair[1].vertical_pos <= pair[0].vertical_pos)
+        || para
+            .text
+            .chars()
+            .skip(*para.control_text_positions().first()?)
+            .any(|ch| !ch.is_whitespace())
+    {
+        return None;
+    }
+    let saved_top = page.vpos_col_anchor
+        + hwpunit_to_px(
+            para.line_segs[0].vertical_pos
+                - page.vpos_page_base.or(page.vpos_lazy_base).unwrap_or(0),
+            dpi,
+        );
+    if (saved_top - page.current_height - fmt.spacing_before).abs() > dpi / 7200.0 * 2.0 {
+        return None;
+    }
+    let prefix_height = fmt.spacing_before + fmt.line_advances_sum(0..cut);
+    let prefix_occupied = prefix_height - fmt.line_spacings[cut - 1];
+    let row_height = hwpunit_to_px(tail.line_height, dpi);
+    let measured = measured_tables
+        .iter()
+        .find(|m| m.para_index == para_idx && m.control_index == 0)?;
+    let top = hwpunit_to_px(i32::from(table.outer_margin_top), dpi);
+    let bottom = hwpunit_to_px(i32::from(table.outer_margin_bottom), dpi);
+    if page.current_height + prefix_occupied > available
+        || (measured.total_height + top + bottom - row_height).abs() > dpi / 7200.0
+        || row_height > available
+    {
+        return None;
+    }
+    let end = row_height + hwpunit_to_px(tail.line_spacing, dpi) + fmt.spacing_after;
+    Some((
+        cut,
+        prefix_height,
+        StoredTacControlPlacement {
+            control_index: 0,
+            // The stored row starts at zero; table layout owns the object margin.
+            inline: InlineBoxPlacement {
+                x: 0.0,
+                y: 0.0,
+                clearance: 0.0,
+                advance_end: Some(end),
+            },
+            end,
+            rebase_line_origin: false,
+        },
+    ))
+}
