+    fn finish_table_structure_edit_by_path(
+        &mut self,
+        section_idx: usize,
+        parent_para_idx: usize,
+        path: &[(usize, usize, usize)],
+        reflow_columns: bool,
+    ) -> Result<(), HwpError> {
+        if reflow_columns {
+            let counts: Vec<usize> = self
+                .resolve_table_by_path(section_idx, parent_para_idx, path)?
+                .cells
+                .iter()
+                .map(|cell| cell.paragraphs.len())
+                .collect();
+            let mut cell_path = path.to_vec();
+            for (cell_idx, count) in counts.into_iter().enumerate() {
+                for cell_para_idx in 0..count {
+                    let last = cell_path.last_mut().unwrap();
+                    last.1 = cell_idx;
+                    last.2 = cell_para_idx;
+                    self.reflow_cell_paragraph_by_path(
+                        section_idx,
+                        parent_para_idx,
+                        &cell_path,
+                        cell_para_idx,
+                    );
+                }
+            }
+        }
+        self.reflow_table_ancestors_by_path(section_idx, parent_para_idx, path);
+        self.document.sections[section_idx].raw_stream = None;
+        self.recompose_section(section_idx);
+        self.paginate_if_needed();
+        Ok(())
+    }
