+                section_idx,
+                parent_para_idx,
+                parent_path,
+                cell_para_idx,
+            );
+            self.recalculate_cell_paragraph_vpos_by_path(
+                section_idx,
+                parent_para_idx,
+                parent_path,
+                cell_para_idx,
+                None,
+            );
+        }
+    }
