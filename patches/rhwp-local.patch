+    /// Used source slots that still need the host's resolved face for kerning.
+    /// Paint-compatible substitutes must not supply these layout font bytes.
+    pub fn get_exact_font_requests_native(&self) -> String {
+        let mut slots = std::collections::HashSet::new();
+        let mut remaining_work_units = 1_000_000usize;
+        for section in &self.document.sections {
+            collect_exact_font_slots_from_paragraphs(
+                &section.paragraphs,
+                &mut slots,
+                &mut remaining_work_units,
+                0,
+            );
+            for master in &section.section_def.master_pages {
+                collect_exact_font_slots_from_paragraphs(
+                    &master.paragraphs,
+                    &mut slots,
+                    &mut remaining_work_units,
+                    0,
+                );
+            }
+        }
+        let mut slots = slots.into_iter().collect::<Vec<_>>();
+        slots.sort_by_key(|slot| (slot.char_shape_id, slot.language_index));
+        let requests = slots
+            .into_iter()
+            .filter_map(|slot| {
+                let style = self.styles.char_styles.get(slot.char_shape_id as usize)?;
+                if !style.kerning || self.layout_engine.exact_font_source_handle(slot).is_some() {
+                    return None;
+                }
+                Some(serde_json::json!({
+                    "charShapeId": slot.char_shape_id,
+                    "languageIndex": slot.language_index,
+                    "family": style.font_family_for_lang(slot.language_index),
+                    "weight": if style.bold { 700 } else { 400 },
+                    "italic": style.italic,
+                }))
+            })
+            .collect::<Vec<_>>();
+        serde_json::json!({ "requests": requests }).to_string()
