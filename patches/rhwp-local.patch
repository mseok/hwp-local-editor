+pub(super) fn source_opening_row_height(
+    st: &super::TypesetState,
+    para: &Paragraph,
+    table: &Table,
+    styles: &ResolvedStyleSet,
+    dpi: f64,
+) -> Option<f64> {
+    let [line] = para.line_segs.as_slice() else {
+        return None;
+    };
