+#[cfg(test)]
+mod bullet_positive_indent_tests {
+    use super::*;
+    use crate::renderer::style_resolver::{ResolvedCharStyle, ResolvedParaStyle};
+
+    fn body_origins(policy: bool, head_type: HeadType, indent: f64, tagged: bool) -> Vec<f64> {
+        let styles = ResolvedStyleSet {
+            char_styles: vec![ResolvedCharStyle {
+                font_family: "맑은 고딕".into(),
+                font_size: 16.0,
+                ..Default::default()
+            }],
+            para_styles: vec![ResolvedParaStyle {
+                alignment: Alignment::Left,
+                head_type,
+                numbering_id: 1,
+                margin_left: 8.0 / 3.0,
+                indent,
+                bullet_preserve_positive_indent: policy,
+                ..Default::default()
+            }],
+            bullets: vec![crate::model::style::Bullet {
+                bullet_char: '\u{F0FC}',
+                attr: 1 << 3,
+                text_distance: 50,
+                char_shape_id: u32::MAX,
+                ..Default::default()
+            }],
+            native_pua_bullet_face: Some("바탕".into()),
+            ..Default::default()
+        };
+        let paragraph = Paragraph {
+            text: "표적분석후보평가".into(),
+            line_segs: (0..2)
+                .map(|i| LineSeg {
+                    text_start: i * 4,
+                    vertical_pos: i as i32 * 1_920,
+                    line_height: 1_200,
+                    baseline_distance: 1_020,
+                    segment_width: 30_000,
+                    tag: if tagged { LineSeg::TAG_INDENTATION } else { 0 },
+                    ..Default::default()
+                })
+                .collect(),
+            ..Default::default()
+        };
+        let composed = ComposedParagraph {
+            lines: ["표적분석", "후보평가"]
+                .into_iter()
+                .enumerate()
+                .map(|(i, text)| ComposedLine {
+                    runs: vec![ComposedTextRun {
+                        text: text.into(),
+                        ..Default::default()
+                    }],
+                    line_height: 1_200,
+                    baseline_distance: 1_020,
+                    segment_width: 30_000,
+                    column_start: 0,
+                    line_spacing: 720,
+                    has_line_break: false,
+                    char_start: i * 4,
+                })
+                .collect(),
+            para_style_id: 0,
+            inline_controls: Vec::new(),
+            numbering_text: bullet_marker_text(&styles.para_styles[0], &styles),
+            tac_controls: Vec::new(),
+            footnote_positions: Vec::new(),
+            tab_extended: Vec::new(),
+            horizontal_shaping: None,
+        };
+        let mut frame = PageLayoutContext::new(0, 400.0, 400.0);
+        let mut column = RenderNode::new(
+            1,
+            RenderNodeType::TextLine(TextLineNode::new(20.0, 15.0)),
+            BoundingBox::new(0.0, 0.0, 400.0, 400.0),
+        );
+        LayoutEngine::new(96.0).layout_composed_paragraph(
+            &mut frame,
+            &mut column,
+            &composed,
+            &styles,
+            &LayoutRect {
+                x: 0.0,
+                y: 0.0,
+                width: 400.0,
+                height: 400.0,
+            },
+            0.0,
+            0,
+            2,
+            0,
+            0,
+            None,
+            false,
+            true,
+            0.0,
+            None,
+            Some(&paragraph),
+            None,
+            None,
+        );
+        column.children.iter().flat_map(|line| &line.children)
+            .filter(|node| matches!(&node.node_type, RenderNodeType::TextRun(run) if run.char_start.is_some()))
+            .map(|node| node.bbox.x).collect()
+    }
+
+    #[test]
+    fn reference_bullet_keeps_positive_style_indent_without_stored_indent_flag() {
+        let flagged = body_origins(true, HeadType::Bullet, 4.0 / 3.0, true);
+        let unflagged = body_origins(true, HeadType::Bullet, 4.0 / 3.0, false);
+        assert_eq!(flagged.len(), 2);
+        assert_eq!(
+            flagged, unflagged,
+            "the reference retains the same first-line indent"
+        );
+    }
+
+    #[test]
+    fn default_body_and_hanging_indent_keep_stored_flag_contract() {
+        for (policy, head, indent) in [
+            (false, HeadType::Bullet, 4.0 / 3.0),
+            (true, HeadType::None, 4.0 / 3.0),
+            (true, HeadType::Bullet, -4.0 / 3.0),
+        ] {
+            let flagged = body_origins(policy, head, indent, true);
+            let unflagged = body_origins(policy, head, indent, false);
+            let index = usize::from(indent < 0.0);
+            assert!((flagged[index] - unflagged[index] - indent.abs()).abs() < 0.001);
+        }
+    }
+}
